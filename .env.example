# Локально: скопируйте в .env. На Vercel: Environment Variables в панели проекта.

TELEGRAM_TOKEN=

# Публичный URL приложения (локально или https://ваш-проект.vercel.app)
SITE_URL=http://localhost:8000

# Секрет для GET /api/telegram/setup-webhook?secret=...
CRON_SECRET=замените_на_длинную_случайную_строку

# PDF для локального парсера и GitHub Actions (secret SCHEDULE_PDF_URL)
SCHEDULE_PDF_URL=

# Код редактора: ДЗ и отмена пар (= HW_EDITOR_CODE в static/index.html)
EDITOR_CODE=0801

# Локально: polling. На Vercel (VERCEL=1) по умолчанию webhook.
TELEGRAM_MODE=polling

SCHEDULE_DIR=schedule_json
UPLOADS_DIR=uploads

# Локально — SQLite. На Vercel — Postgres (Neon), иначе данные сбросятся:
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./schedule.db

HOST=0.0.0.0
PORT=8000
RELOAD=1
NOTIFY_BEFORE_HOURS=24

# Опционально: Postgres на Vercel вместо /tmp SQLite
# DATABASE_URL=postgresql://...

# Скопируйте в .env (локально) или задайте в PythonAnywhere → Web → Environment variables.
# Файл .env в git не коммитить.

# ─── Telegram (только PythonAnywhere) ───
TELEGRAM_TOKEN=

# Публичный URL сайта на Vercel (без /api) — ссылки на файлы ДЗ в боте
SITE_URL=https://ваш-проект.vercel.app

# PDF расписания (GitHub secret SCHEDULE_PDF_URL и/или локально в run.py)
SCHEDULE_PDF_URL=

# ─── PythonAnywhere: API + бот ───
# Внутренний URL API для бота (с /api в конце)
API_INTERNAL_URL=https://ВАШ_ЛОГИН.pythonanywhere.com/api

# CORS: домен Vercel (через запятую)
CORS_ORIGINS=https://ваш-проект.vercel.app

# ─── Данные на сервере API ───
SCHEDULE_DIR=schedule_json
UPLOADS_DIR=uploads
DATABASE_URL=sqlite:////home/ВАШ_ЛОГИН/vetschedule/schedule.db

HOST=0.0.0.0
PORT=8000

NOTIFY_BEFORE_HOURS=24

# Код редактора: ДЗ и отмена пар (сайт, бот, POST /api/lesson-overrides/toggle)
EDITOR_CODE=0801

# Локально: hot-reload uvicorn (на PA не задавать или RELOAD=0)
RELOAD=1

# ─── Только Vercel (Environment Variables → Build) ───
# API_PUBLIC_URL=https://ВАШ_ЛОГИН.pythonanywhere.com
# Скрипт scripts/inject_api_config.py запишет это в static/config.js при сборке.

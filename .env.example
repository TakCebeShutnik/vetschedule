# Скопируйте в .env и заполните. Файл .env в git не коммитить.

# Telegram (@BotFather)
TELEGRAM_TOKEN=

# Публичный URL сайта (на Render: https://ваш-сервис.onrender.com)
SITE_URL=http://localhost:8000

# Парсер при локальном run.py (на Render и в Actions — отдельно)
SCHEDULE_PDF_URL=

# Папки и БД
SCHEDULE_DIR=schedule_json
UPLOADS_DIR=uploads
DATABASE_URL=sqlite:///./schedule.db

HOST=0.0.0.0
PORT=8000

# Таймаут запросов бота к API (секунды)
API_HTTP_TIMEOUT=60

# Напоминания о дедлайнах (если включите статусы ДЗ в bot.py)
NOTIFY_BEFORE_HOURS=24
